# Add a key only in .env.local (git-ignored), never in a VITE_ variable.
OPENAI_API_KEY=
PORTFOLIO_LLM_PROVIDER=openai
PORTFOLIO_LLM_MODEL=gpt-5.6-luna

# Manual alternative only. No automatic paid-provider fallback.
# PORTFOLIO_LLM_PROVIDER=gemini
# PORTFOLIO_LLM_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=

# Optional custom endpoint (base URL and generic key apply only to compatible):
# PORTFOLIO_LLM_PROVIDER=compatible
# PORTFOLIO_LLM_BASE_URL=https://your-provider.example/v1
# PORTFOLIO_LLM_MODEL=your-model-id
PORTFOLIO_LLM_BASE_URL=
PORTFOLIO_LLM_API_KEY=

# Shared on Vercel via Upstash Redis. Missing/unavailable storage disables paid
# calls and returns notes. Local development also has per-process limits.
PORTFOLIO_LLM_REQUESTS_PER_MINUTE=12
PORTFOLIO_LLM_DAILY_REQUEST_LIMIT=200
PORTFOLIO_LLM_MONTHLY_BUDGET_USD=5
# Vercel's integration may supply KV_REST_API_URL/TOKEN instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
